# Browser-safe public Supabase configuration only
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Server-only runtime secrets; never prefix these with VITE_ or expose them to browser code
ALADIN_TTB_KEY=your_aladin_ttb_key_here
NOTION_TOKEN=secret_your_notion_integration_token
NOTION_WORKS_DATABASE_ID=your_notion_database_id
NOTION_MEDIA_DATABASE_ID=your_notion_media_database_id
NOTION_LOG_DATABASE_ID=your_notion_exploration_log_database_id
